    "faqs": [
      {
        "id": "support-faq-1",
        "question": {
          "en": "Fingerprint recognition fails",
          "zh": "指纹识别失败"
        },
        "answer": {
          "en": "Dry or clean the sensor, then re-enrol the print with even pressure. Avoid moisture and heavy gloves during setup.",
          "zh": "擦干并清洁传感器，再以均匀力度重新录入。设置时避免潮湿或厚手套。"
        }
      },
      {
        "id": "support-faq-2",
        "question": {
          "en": "Charging / power issues",
          "zh": "充电 / 供电问题"
        },
        "answer": {
          "en": "Use a USB-C cable. If the lock is fully drained, connect a power bank to the Type-C port to unlock, then charge fully.",
          "zh": "请使用 USB-C 线。若电量耗尽，可用充电宝连接 Type-C 口应急开锁，再完整充电。"
        }
      },
      {
        "id": "support-faq-3",
        "question": {
          "en": "Using the mechanical key",
          "zh": "使用机械钥匙"
        },
        "answer": {
          "en": "The backup key is for emergencies. Insert fully, turn firmly, then store the key separately from the lock.",
          "zh": "备用钥匙仅用于应急。完全插入后用力转动，平时请与锁分开存放。"
        }
      }
    ]
