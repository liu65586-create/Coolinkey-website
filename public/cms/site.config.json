  "midModules": {
    "a": {
      "enabled": true,
      "title": {
        "en": "Designed for bikes, e-bikes, gates, doors and more",
        "zh": "为自行车、电助力自行车、门和大门等多种场景而设计"
      },
      "slides": [
        {
          "mediaUrl": "/uploads/20261018T162036-1600X1600-6.jpg",
          "mediaKind": "image",
          "text": {
            "en": "More than a bike lock, Coolinkey is designed to adapt to the way you secure your everyday essentials. From bicycles and e-bikes to gates and doors, its versatile chain design offers a flexible locking solution for a variety of everyday situations",
            "zh": "Coolinkey 采用灵活的链条式设计，让锁具的使用不再局限于自行车。从自行车、电助力自行车到门和大门，为不同场景提供更灵活的锁定选择，让日常防护更加便捷。"
          },
          "id": "mid-a-1",
          "imageFit": "cover",
          "focus": "50% 50%"
        }
      ]
    },
    "b": {
      "enabled": false,
      "title": {
        "en": "Engineered for reliability",
        "zh": "为可靠而生"
      },
      "slides": [
        {
          "mediaUrl": "/images/defaults/mid-module-b-test.png",
          "mediaKind": "image",
          "text": {
            "en": "IP67 sealing helps keep dust and water out of the electronics. Bluetooth 5.0 keeps pairing stable in busy signal environments.",
            "zh": "IP67 结构有助于阻隔粉尘与水汽侵入电子腔体；蓝牙 5.0 在复杂无线环境下保持连接稳定。"
          },
          "id": "mid-b-1",
          "imageFit": "cover",
          "focus": "50% 50%"
        }
      ]
    },
    "d": {
      "enabled": true,
      "title": {
        "en": "Designed with Purpose. Crafted with Car",
        "zh": "以设计为本，以匠心打磨每一处细节"
      },
      "slides": [
        {
          "mediaUrl": "/uploads/20261018T161813-production_process_showcase_640.gif",
          "mediaKind": "image",
          "text": {
            "en": "At Coolinkey, we believe that a better locking experience begins with thoughtful design and attention to every detail. From the structure of each component to the finish of the final product, we focus on creating smart locking solutions that bring together functionality, refined design, and everyday convenience.",
            "zh": "在 Coolinkey，我们相信，更好的锁具体验始于用心的设计与对细节的专注。从每一个零部件的结构，到最终产品的外观与质感，我们始终致力于打造兼顾实用功能、精致设计与日常便捷体验的智能锁具产品。"
          },
          "id": "mid-d-1",
          "imageFit": "cover",
          "focus": "50% 50%"
        }
      ]
    }
